@model Library_BDwAI.Models.Book

@{
    ViewData["Title"] = "Usuń książkę";
}

<h1>Usuń książkę</h1>

<h3>Czy na pewno chcesz usunąć ten wpis?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Author)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Author)
        </dd>
        <dt class="col-sm-2">
            Gatunek
        </dt>
        <dd class="col-sm-10">
            @(Model.Genre != null ? Model.Genre.Name : "Brak")
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Usuń" class="btn btn-danger" />
        <a asp-action="BooksList" class="btn btn-secondary">Anuluj</a>
    </form>
</div>
