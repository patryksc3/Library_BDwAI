    @model Library_BDwAI.Models.Book

@{
    ViewData["Title"] = "Usuń egzemplarze książki";
}

<div class="container mt-4">
    <h1>Usuń egzemplarze książki</h1>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Tytuł</dt>
        <dd class="col-sm-9 fw-bold">@Model.Title</dd>

        <dt class="col-sm-3">Autor</dt>
        <dd class="col-sm-9">@Model.Author</dd>

        <dt class="col-sm-3">Gatunek</dt>
        <dd class="col-sm-9">
            <span class="badge bg-info text-dark">
                @(Model.Genre != null ? Model.Genre.Name : "Brak")
            </span>
        </dd>

        <dt class="col-sm-3">Dostępne egzemplarze</dt>
        <dd class="col-sm-9">
            <span class="text-success fw-bold">@Model.CopiesAvailable szt.</span>
        </dd>
    </dl>

    <form asp-action="DeleteBook" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label for="copiesToRemove" class="form-label">Ile egzemplarzy usunąć?</label>
            <input type="number"
                   id="copiesToRemove"
                   name="copiesToRemove"
                   class="form-control"
                   min="1"
                   max="@Model.CopiesAvailable"
                   value="@Model.CopiesAvailable"
                   required />
            <div class="form-text">
                Możesz usunąć od 1 do @Model.CopiesAvailable egzemplarzy. Usunięcie wszystkich spowoduje trwałe usunięcie książki z katalogu.
            </div>
        </div>

        <button type="submit" class="btn btn-danger">Usuń</button>
        <a asp-action="BooksList" class="btn btn-secondary">Anuluj</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
