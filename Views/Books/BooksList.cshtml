@model IEnumerable<Library_BDwAI.Models.Book>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Katalog Książek";

    var userRole = Context.Session.GetString("UserRole");
    var userId = Context.Session.GetInt32("UserId");
    var isAdmin = userRole == "Admin";
    var isLoggedIn = userId != null;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Katalog Książek</h1>

        @if (isAdmin)
        {
            <a asp-action="AddBook" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Dodaj nową książkę
            </a>
        }
    </div>

    <table class="table table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Author)</th>
                <th>Gatunek</th>
                <th>Rok</th>
                <th>Dostępne</th>
                <th class="text-center">Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="align-middle">
                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@Html.DisplayFor(modelItem => item.Author)</td>
                    <td>
                        <span class="badge bg-info text-dark">
                            @(item.Genre != null ? item.Genre.Name : "Brak")
                        </span>
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.PublishedYear)</td>
                    <td>
                        @if (item.CopiesAvailable > 0)
                        {
                            <span class="text-success fw-bold">@item.CopiesAvailable szt.</span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold">Niedostępna</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm mx-1">Szczegóły</a>

                        @if (isAdmin)
                        {
                            <a asp-action="EditBook" asp-route-id="@item.Id" class="btn btn-warning btn-sm mx-1">Edytuj</a>
                            <a asp-action="DeleteBook" asp-route-id="@item.Id" class="btn btn-danger btn-sm mx-1">Usuń</a>
                        }
                        else if (isLoggedIn)
                        {
                            @if (item.CopiesAvailable > 0)
                            {
                                <a asp-action="Borrow" asp-route-id="@item.Id" class="btn btn-success btn-sm mx-1">Wypożycz</a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm mx-1" disabled>Brak kopii</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>